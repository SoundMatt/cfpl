# --- Router (local web-admin API; enable it on the router if needed) ---
PEPLINK_URL=https://192.168.1.1
PEPLINK_USER=admin
PEPLINK_PASS=change-me
PEPLINK_VERIFY_TLS=0

# --- Cloudflare: scoped token, Zone:Zone:Read + Zone:DNS:Edit on ONE zone ---
CF_TOKEN=
CF_ZONE=example.com
# CF_ZONE_ID=            # optional; skips the zone lookup
# Comma separated. "host=2" pins a host to WAN id 2; plain host follows the active WAN.
CF_HOSTS=home.example.com
CF_PROXIED=0             # 1 only for HTTP/HTTPS services
CF_TTL=60

# --- Behaviour ---
# STANDBY_IP=            # published when every WAN is down (e.g. cloud FusionHub Elastic IP)
POLL_INTERVAL=10
DEBOUNCE_POLLS=2         # same answer this many polls in a row before updating
DRY_RUN=1                # set to 0 once Verify output looks right
